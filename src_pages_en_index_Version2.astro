---
// Minimal Home page (EN)
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
const lang = 'en';
---
<Layout lang={lang}>
  <Hero
    name="Muhammad Dliya'ul Haq"
    title="Data Analyst • HSE (K3) • PPIC"
    subtitle="Industrial Engineering graduate focused on production efficiency and safety. I use data analysis and scheduling optimization to reduce downtime and improve processes."
    ctaPrimary={{ label: 'See Work', href: '/en/work' }}
    ctaSecondary={{ label: 'Download CV', href: '/public/CV.pdf' }}
  />
  <section class="container mx-auto py-8 px-4">
    <h2 class="text-2xl font-semibold mb-4">Selected Projects</h2>
    <p class="text-gray-600">Project cards will appear here. (Project details to follow)</p>
  </section>
</Layout>