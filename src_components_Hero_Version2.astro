---
const { name, title, subtitle, ctaPrimary, ctaSecondary } = Astro.props;
---
<section class="bg-white shadow-sm">
  <div class="container mx-auto px-4 py-12 flex flex-col md:flex-row items-center gap-8">
    <div class="flex-1">
      <h1 class="text-4xl md:text-5xl font-serif mb-3">{name}</h1>
      <p class="text-xl text-primary font-medium mb-4">{title}</p>
      <p class="text-gray-700 mb-6">{subtitle}</p>
      <div class="flex gap-3">
        <a class="bg-primary text-white px-4 py-2 rounded" href={ctaPrimary.href}>{ctaPrimary.label}</a>
        <a class="border border-primary text-primary px-4 py-2 rounded" href={ctaSecondary.href}>{ctaSecondary.label}</a>
      </div>
    </div>
    <div class="w-44 h-44 md:w-56 md:h-56 rounded overflow-hidden bg-gray-100">
      <img src="/assets/headshot.jpg" alt="Headshot" class="w-full h-full object-cover" />
    </div>
  </div>
</section>